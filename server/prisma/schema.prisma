// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PasswordResetOtp {
  id        String   @id @default(uuid())
  userId    String
  otpHash   String
  expiredAt DateTime
  createdAt DateTime @default(now())
  attempts  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginOtp {
  id        String   @id @default(uuid())
  userId    String
  otpHash   String
  expiredAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RegisterOtp {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  otpHash   String
  createdAt DateTime @default(now())
  expiredAt DateTime
  attempts  Int      @default(0)

  @@index([userId])
}

model User {
  id       String  @id @default(uuid())
  name     String
  username String? @unique
  email    String  @unique
  password String?

  avatar String?

  refreshToken String?

  isEmailVerified Boolean @default(false)
  isActive        Boolean @default(false)

  loginOtps           LoginOtp[]
  passwordResetOtps   PasswordResetOtp[]
  registerOtp         RegisterOtp[]
  organizations       OrganizationMember[]
  sentInvitation      OrganizationInvitation[]  @relation("organizationInviter")
  joinRequests        OrganizationJoinRequest[]
  reviewedJoinRequest OrganizationJoinRequest[] @relation("JoinRequestReviewer")

  projectMemberships ProjectMember[]
  oauthAccounts      OAuthAccount[]
  teamMemberships    TeamMember[]
  teamJoinRequests   TeamJoinRequest[]
  reviewedTeamJoinRequest TeamJoinRequest[] @relation("teamJoinRequestReviewer")

  teamInvitationRecieved TeamInvitation[]  @relation("TeamInvitationsReceived")
  teamInvitationsSent TeamInvitation[] @relation("TeamInvitationsSent")


  conversationMembers ConversationMember[] @relation("conversationMembers")
  sentMessages Message[]  @relation("messageSender")
  deletedMessages Message[] @relation("messageDeleter")
  pinnedMessages Message[]  @relation("messagePinner")
  messageReactions MessageReaction[] @relation("messageReactions")
  messageReads MessageRead[] @relation("messageReaders")
  messageMentions MessageMention[] @relation("messageMentions")



  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OAuthAccount {
  id String @id @default(uuid())

  provider   AuthProvider
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([provider, providerId])
  @@index([userId])
}

model Organization {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  avatar      String?
  isActive    Boolean @default(true)

  allowJoinRequests Boolean                @default(false)
  visibility        OrganizationVisibility @default(PRIVATE)

  members      OrganizationMember[]
  invitations  OrganizationInvitation[]
  joinRequests OrganizationJoinRequest[]
  projects     Project[]
  teams        Team[]

  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationMember {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role OrganizationRole @default(MEMBER)

  joinedAt DateTime @default(now())

  @@unique([organizationId, userId])
}

model OrganizationInvitation {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("organizationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  email String

  role OrganizationRole @default(MEMBER)

  tokenHash String @unique

  expiresAt DateTime

  invitedAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  status InvitationStatus @default(PENDING)

  respondedAt DateTime?


  @@unique([organizationId, email])
  @@index([email])
  @@index([expiresAt])
}

model OrganizationJoinRequest {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User?   @relation("JoinRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  message String?

  status joinRequestStatus @default(PENDING)

  reviewedAt DateTime?

  requestedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([userId])
}

model Project {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String?
  avatar      String?

  isArchieved Boolean @default(false)

  members ProjectMember[]

  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model ProjectMember {
  id String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role projectRole

  joinedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Team {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String?
  avatar      String?

  isActive Boolean @default(true)

  members TeamMember[]
  invitations TeamInvitation[]
  joinRequests TeamJoinRequest[]

  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model TeamMember {
  id String @id @default(uuid())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role TeamRole

  joinedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model TeamInvitation{
  id String @id @default(uuid())

  teamId String 
  team Team @relation(fields:[teamId] , references:[id],onDelete:Cascade)

  invitedUserId String
  inviteduser User @relation("TeamInvitationsReceived" ,fields:[invitedUserId],references:[id],onDelete:Cascade)

  invitedById String
  invitedBy User @relation("TeamInvitationsSent" , fields:[invitedById],references:[id],onDelete:Cascade)

  tokenHash String @unique

  status TeamInvitationStatus @default(PENDING)

  message String?

  expiresAt DateTime

  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, invitedUserId])
  @@index([teamId, status])
  @@index([invitedUserId, status])
  @@index([expiresAt])
}


model TeamJoinRequest{
  id String @id @default(uuid())

  teamId String 
  team Team @relation(fields:[teamId] ,references:[id],onDelete:Cascade)

  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)

  reviewedById String?
  reviewedBy   User?   @relation("teamJoinRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  message String?

  status TeamJoinRequestStatus @default(PENDING)

  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId,userId])
  @@index([teamId,status])
  @@index([userId , status])
}



model Conversation{
  id String @id @default(uuid())

  type ConversationType

  organizationId String? @unique
  organization Organization? @relation(fields :[organizationId] , references:[id] , onDelete:Cascade)

  teamId String? @unique
  team Team? @relation(fields:[teamId],references:[id],onDelete:Cascade)

  projectId String? @unique
  project Project? @relation(fields : [projectId] , references:[id] , onDelete:Cascade)

  // Used for 1-to-1 direct messages.
  // Generated from the two user IDs in sorted order.
  directKey String? @unique

  name String?

  members ConversationMember[]
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([organizationId])
  @@index([teamId])
  @@index([projectId])

}

model ConversationMember{
  id String @id @default(uuid())

  conversationId String
  conversation Conversation @relation(fields : [conversationId] , references:[id] , onDelete:Cascade)

  userId String
  user User @relation("conversationMembers",fields:[userId] , references:[id],onDelete:Cascade)

  //for calculating the unread message 
  lastReadAt DateTime?

  joinedAt DateTime @default(now())

  isMuted Boolean @default(false)
  mutedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message{
  id String @id @default(uuid())

  conversationId String
  conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)

  senderId String
  sender User @relation("messageSender" , fields:[senderId],references:[id],onDelete:Cascade)

  type MessageType @default(TEXT)

  content String?

  replyToId String?
  replyTo Message? @relation("messageReplies",fields:[replyToId],references:[id],onDelete:SetNull)
  replies Message[] @relation("messageReplies")

  isEdited Boolean   @default(false)
  editedAt DateTime?

  deleledAt DateTime?
  deletedById String? 
  deletedBy User? @relation("messageDeleter", fields:[deletedById],references:[id],onDelete:Cascade)

  pinnedAt DateTime?
  pinnedById String?
  pinnedBy User? @relation("messagePinner" , fields:[pinnedById],references:[id],onDelete:Cascade)

  attachments MessageAttachment[]
  reactions   MessageReaction[]
  reads       MessageRead[]
  mentions    MessageMention[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId, createdAt])
  @@index([conversationId, id])
  @@index([senderId])
  @@index([replyToId])
}

model MessageReaction{
  id String @id @default(uuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation("messageReactions", fields: [userId], references: [id], onDelete: Cascade)

  emoji String

  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

model MessageRead{
  id String @id @default(uuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation("messageReaders", fields: [userId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}

model MessageMention{
  id String @id @default(uuid())

  messageId String
  message Message @relation(fields:[messageId],references:[id],onDelete:Cascade)

  userId String
  user   User @relation("messageMentions", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([messageId , userId])
  @@index([userId])
}

model MessageAttachment{
  id String @id @default(uuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  originalName String
  storageKey   String

  mimeType     String
  sizeBytes    Int

  url          String?
  thumbnailUrl String?

  createdAt DateTime @default(now())

  @@index([messageId])
}





enum AuthProvider {
  EMAIL
  GOOGLE
  GITHUB
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum joinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrganizationVisibility {
  PRIVATE
  PUBLIC
}

enum projectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum TeamJoinRequestStatus{
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ConversationType{
  ORGANIZATION
  TEAM
  PROJECT
  DIRECT
}

enum MessageType{
  TEXT
  IMAGE
  FILE
  SYSTEM
}

