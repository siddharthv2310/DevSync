// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}




model PasswordResetOtp{
  id       String @id @default(uuid())
  userId   String
  otpHash  String
  expiredAt DateTime
  createdAt DateTime @default(now())
  attempts  Int @default(0)

  user User @relation(fields : [userId] , references : [id] , onDelete:Cascade)

  @@index([userId])
}




model LoginOtp{
  id       String  @id @default(uuid())
  userId   String
  otpHash  String
  expiredAt DateTime
  attempts  Int @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields : [userId] , references : [id], onDelete : Cascade)

  @@index([userId])

}




model RegisterOtp{
  id String @id @default(uuid())

  userId  String 
  user User @relation(fields:[userId],references:[id] , onDelete:Cascade)

  otpHash String
  createdAt DateTime @default(now())
  expiredAt DateTime
  attempts Int @default(0)

  @@index([userId])
}




model User {
  id        String      @id @default(uuid())
  name      String
  username  String?  @unique
  email     String   @unique
  password  String?

  avatar    String?

  refreshToken String?

  isEmailVerified Boolean @default(false)
  isActive  Boolean @default(false)

  loginOtps LoginOtp[]
  passwordResetOtps PasswordResetOtp[]
  registerOtp RegisterOtp[]
  organizations OrganizationMember[]
  sentInvitation OrganizationInvitation[] @relation("organizationInviter")
  joinRequests OrganizationJoinRequest[] 
  reviewedJoinRequest OrganizationJoinRequest[] @relation("JoinRequestReviewer")

  oauthAccounts OAuthAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}




model OAuthAccount{
  id String @id @default(uuid())

   provider  AuthProvider
   providerId String

   userId  String
   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   createdAt DateTime @default(now())

  @@unique([provider, providerId])
  @@index([userId])
}



model Organization {
  id          String @id @default(uuid())
  name        String
  slug        String @unique
  description String?
  avatar      String?
  isActive    Boolean @default(true)

  members OrganizationMember[]
  invitations OrganizationInvitation[]
  joinRequests OrganizationJoinRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model OrganizationMember {
  id String @id @default(uuid())

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role OrganizationRole @default(MEMBER)

  joinedAt DateTime @default(now())

  @@unique([organizationId, userId])
}




model OrganizationInvitation{
  id String @id @default(uuid())

  organizationId String
  organization Organization @relation(fields:[organizationId] , references:[id] , onDelete:Cascade)

  invitedById String 
  invitedBy User @relation("organizationInviter" , fields:[invitedById] , references:[id] , onDelete:Cascade)

  email String 

  role OrganizationRole @default(MEMBER)

  tokenHash String

  expiredAt DateTime

  invitedAt DateTime @default(now())

  status InvitationStatus @default(PENDING)

  acceptedAt DateTime?

  @@unique([organizationId , email])
  @@index([email])
  @@index([expiredAt])
}



model OrganizationJoinRequest{

  id String @id @default(uuid())

  userId String 
  user User @relation(fields:[userId] , references:[id],onDelete:Cascade)

  organizationId String
  organization Organization @relation(fields:[organizationId] , references:[id],onDelete:Cascade)

  reviewedById String?
  reviewedBy User? @relation("JoinRequestReviewer", fields:[reviewedById] , references:[id] , onDelete:SetNull)

  message String?

  status joinRequestStatus @default(PENDING)

  reviewedAt DateTime?

  requestedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([userId])

}



enum AuthProvider{
  EMAIL
  GOOGLE
  GITHUB
}
enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus{
  PENDING
  ACCEPTED
  CANCELLED
}
enum joinRequestStatus{
  PENDING
  APPROVED
  REJECTED
}
